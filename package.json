{
  "name": "melo-lite",
  "version": "2.0.0",
  "packageManager": "pnpm@11.22.0",
  "description": "A personal knowledge workspace built around CODE.",
  "main": "./out/main/index.js",
  "author": "Melo",
  "homepage": "https://www.melolib.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node node_modules/electron/install.js && node scripts/prepare-electron.mjs && electron-rebuild --force --only better-sqlite3",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:mac:unsigned": "pnpm run release:check && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "build:mac:universal": "pnpm run build && electron-builder --mac --universal --publish never",
    "build:linux": "electron-vite build && electron-builder --linux",
    "deploy:mac": "pnpm run release:check && electron-builder build --mac --publish always",
    "release:check": "pnpm run typecheck && pnpm test && electron-vite build",
    "release": "standard-version",
    "release:first": "standard-version --first-release",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:major": "standard-version --release-as major",
    "release:custom": "standard-version --release-as",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "test": "vitest run --exclude 'src/main/**' && pnpm run test:main",
    "test:main": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run src/main",
    "test:e2e:single-instance": "pnpm run build && node scripts/e2e-single-instance.mjs",
    "test:e2e:workspace": "pnpm run build && node scripts/e2e-workspace-watcher.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@mozilla/readability": "^0.6.0",
    "@parcel/watcher": "^2.6.0",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-paragraph": "^3.25.0",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.1.7",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.12",
    "mime-types": "^2.1.35",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@ariakit/react": "^0.4.29",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "3.6.1",
    "@floating-ui/dom": "^1.6.0",
    "@floating-ui/react": "^0.26.28",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.11.2",
    "@tiptap/extension-code-block-lowlight": "^3.25.0",
    "@tiptap/extension-bubble-menu": "^3.25.0",
    "@tiptap/extension-drag-handle-react": "^3.25.0",
    "@tiptap/extension-document": "^3.25.0",
    "@tiptap/extension-emoji": "^3.25.0",
    "@tiptap/extension-highlight": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-list": "^3.25.0",
    "@tiptap/extension-mathematics": "^3.25.0",
    "@tiptap/extension-node-range": "^3.25.0",
    "@tiptap/extension-subscript": "^3.25.0",
    "@tiptap/extension-superscript": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-of-contents": "^3.25.0",
    "@tiptap/extension-text": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-typography": "^3.25.0",
    "@tiptap/extensions": "^3.25.0",
    "@tiptap/markdown": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@tiptap/suggestion": "^3.25.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "^3.0.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vitejs/plugin-react": "^4.3.1",
    "alfaaz": "^1.1.0",
    "antd": "^5.24.3",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "conventional-changelog": "^6.0.0",
    "electron": "^31.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "framer-motion": "^11.3.6",
    "history": "^5.3.0",
    "i18next": "^26.3.6",
    "jotai": "^2.12.2",
    "jotai-devtools": "^0.11.0",
    "katex": "^0.16.11",
    "linkifyjs": "^4.1.3",
    "lodash.debounce": "^4.0.8",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.424.0",
    "playwright-core": "^1.61.1",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prosemirror-virtual-cursor": "^0.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.28.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.77.8",
    "sonner": "^1.7.0",
    "standard-version": "^9.5.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.29.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-plugin-svgr": "^4.2.0",
    "vitest": "^2.1.9"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "sideEffects": [
    "src/main/userData.ts"
  ]
}
